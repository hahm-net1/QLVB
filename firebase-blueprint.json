{
  "entities": {
    "Task": {
      "title": "Task",
      "description": "Văn bản giao việc kỹ thuật VNPT",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "docNumber": { "type": "string", "maxLength": 100 },
        "title": { "type": "string", "maxLength": 1000 },
        "issueDate": { "type": "string", "maxLength": 20 },
        "dueDate": { "type": "string", "maxLength": 20 },
        "assignee": { "type": "string", "maxLength": 100 },
        "department": { "type": "string", "maxLength": 100 },
        "priority": { "type": "string", "enum": ["Bình thường", "Quan trọng", "Khẩn cấp"] },
        "status": { "type": "string", "enum": ["Đang thực hiện", "Hoàn thành", "Tạm dừng", "Chờ duyệt"] },
        "progressPercent": { "type": "number" },
        "notes": { "type": "array" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "docNumber", "title", "dueDate", "assignee", "status", "priority"]
    },
    "DailyNote": {
      "title": "DailyNote",
      "description": "Ghi chú nhắc việc cá nhân theo ngày dạng To-Do List",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "noteDate": { "type": "string", "maxLength": 30 },
        "title": { "type": "string", "maxLength": 1000 },
        "details": { "type": "string", "maxLength": 2000 },
        "dueDate": { "type": "string", "maxLength": 30 },
        "assignee": { "type": "string", "maxLength": 100 },
        "priority": { "type": "string", "enum": ["Bình thường", "Quan trọng", "Khẩn cấp"] },
        "completed": { "type": "boolean" },
        "completedAt": { "type": "string", "maxLength": 50 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "noteDate", "title", "dueDate", "completed"]
    }
  },
  "firestore": {
    "/tasks/{taskId}": {
      "schema": "Task",
      "description": "Danh sách các văn bản điều hành, giao việc và đôn đốc kỹ thuật"
    },
    "/daily_notes/{noteId}": {
      "schema": "DailyNote",
      "description": "Danh sách Note theo ngày dạng To-Do List có hạn hoàn thành và cảnh báo"
    }
  }
}
